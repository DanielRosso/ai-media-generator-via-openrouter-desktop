<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:vid_img_frontend_net_core.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="vid_img_frontend_net_core.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://vid-img-frontend-net-core/Assets/favicon.ico"
        Title="Media Generator"
        MinWidth="700"
        MinHeight="580"
        Background="#1E1E2E">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             SETUP PANEL – shown when no API key is configured
             ══════════════════════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding !IsApiKeyConfigured}"
                Background="#1E1E2E"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20"
                        MaxWidth="480"
                        Margin="32">

                <!-- Icon + Title -->
                <TextBlock Text="🔑 API-Key einrichten"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"/>

                <!-- Description -->
                <TextBlock TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#A6ADC8"
                           FontSize="14">
                    Um Bilder und Videos zu generieren, benötigst du einen
                    OpenRouter API-Key. Dieser wird sicher in deinem lokalen
                    AppData-Verzeichnis gespeichert und nie übertragen.
                </TextBlock>

                <!-- Link hint -->
                <TextBlock Text="👉 openrouter.ai/keys"
                           Foreground="#89B4FA"
                           FontSize="13"
                           HorizontalAlignment="Center"/>

                <!-- Key input -->
                <TextBox Text="{Binding ApiKeyInput}"
                         PlaceholderText="sk-or-v1-..."
                         PasswordChar="•"
                         FontSize="14"
                         Padding="12,10"
                         Background="#313244"
                         Foreground="#CDD6F4"
                         BorderBrush="#585B70"
                         BorderThickness="1"
                         CornerRadius="8"/>

                <!-- Save button -->
                <Button Content="✅ Key speichern"
                        Command="{Binding SaveApiKeyCommand}"
                        HorizontalAlignment="Stretch"
                        Height="44"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#89B4FA"
                        Foreground="#1E1E2E"
                        CornerRadius="8"
                        Cursor="Hand"/>

                <!-- Setup status / error -->
                <TextBlock Text="{Binding SetupStatusMessage}"
                           Foreground="#F38BA8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding SetupStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             MAIN UI – shown once the API key is configured
             ══════════════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Margin="24"
              IsVisible="{Binding IsApiKeyConfigured}">

            <!-- Title row with Reset-Key button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0"
                           Text="🎨 Media Generator"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#CDD6F4"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="🔑 Key ändern"
                        Command="{Binding ResetApiKeyCommand}"
                        Height="34"
                        Padding="12,0"
                        FontSize="12"
                        Background="#45475A"
                        Foreground="#CDD6F4"
                        CornerRadius="6"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 1: Prompt TextBox + Media-Type ComboBox + Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">

                <!-- Prompt TextBox -->
                <TextBox Grid.Column="0"
                         Text="{Binding PromptText}"
                         PlaceholderText="Beschreibe dein Bild oder Video..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="90"
                         MaxHeight="150"
                         VerticalAlignment="Stretch"
                         Padding="12,10"
                         FontSize="14"
                         Background="#313244"
                         Foreground="#CDD6F4"
                         BorderBrush="#585B70"
                         BorderThickness="1"
                         CornerRadius="8"
                         Margin="0,0,12,0"/>

                <!-- Media Type ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding MediaTypes}"
                          SelectedItem="{Binding SelectedMediaType}"
                          Width="120"
                          Height="42"
                          VerticalAlignment="Top"
                          Background="#313244"
                          Foreground="#CDD6F4"
                          BorderBrush="#585B70"
                          BorderThickness="1"
                          CornerRadius="8"
                          Margin="0,0,12,0"/>

                <!-- Generate Button -->
                <Button Grid.Column="2"
                        Content="✨ Generieren"
                        Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Width="140"
                        Height="42"
                        VerticalAlignment="Top"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#89B4FA"
                        Foreground="#1E1E2E"
                        CornerRadius="8"
                        Cursor="Hand"
                        Margin="0,0,12,0"/>

                <!-- Save Button -->
                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Content="💾 Bild speichern"
                        IsEnabled="{Binding CanSaveImage}"
                        Width="150"
                        Height="42"
                        VerticalAlignment="Top"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#A6E3A1"
                        Foreground="#1E1E2E"
                        CornerRadius="8"
                        Cursor="Hand"
                        Click="SaveButton_Click"/>
            </Grid>

            <!-- Row 2: Model Selection ComboBox -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <TextBlock Grid.Column="0"
                           Text="Modell:"
                           Foreground="#A6ADC8"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}"
                          HorizontalAlignment="Stretch"
                          Height="38"
                          Background="#313244"
                          Foreground="#CDD6F4"
                          BorderBrush="#585B70"
                          BorderThickness="1"
                          CornerRadius="8"/>
            </Grid>

            <!-- Result Area -->
            <Border Grid.Row="3"
                    Background="#181825"
                    BorderBrush="#585B70"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    ClipToBounds="True">

                <Grid>
                    <!-- Placeholder: nothing generated yet -->
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#585B70"
                               FontSize="16"
                               TextAlignment="Center">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="GeneratedImage" Converter="{x:Static ObjectConverters.IsNull}"/>
                                <Binding Path="HasVideoResult" Converter="{x:Static BoolConverters.Not}"/>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                        Das generierte Bild oder Video erscheint hier...
                    </TextBlock>

                    <!-- Generated Image (image mode) -->
                    <Image Source="{Binding GeneratedImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding GeneratedImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- Video result panel -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="20"
                                IsVisible="{Binding HasVideoResult}">

                        <TextBlock Text="🎬 Video erfolgreich generiert!"
                                   Foreground="#A6E3A1"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding GeneratedVideoUrl}"
                                   Foreground="#89B4FA"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   MaxWidth="600"
                                   TextAlignment="Center"/>

                        <Button Content="⬇ Video herunterladen und speichern"
                                HorizontalAlignment="Center"
                                Height="46"
                                Padding="24,0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Background="#CBA6F7"
                                Foreground="#1E1E2E"
                                CornerRadius="8"
                                Cursor="Hand"
                                Click="DownloadVideoButton_Click"/>
                    </StackPanel>

                    <!-- Loading Overlay -->
                    <Border Background="#AA181825"
                            IsVisible="{Binding IsLoading}"
                            CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <TextBlock Text="⏳ Generiere..."
                                       Foreground="#89B4FA"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Bitte warten, das kann mehrere Minuten dauern."
                                       Foreground="#A6ADC8"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="4"
                    Background="#313244"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,8"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Debug Log Panel – visible only on API errors -->
            <Border Grid.Row="5"
                    Background="#2D1B1B"
                    BorderBrush="#F38BA8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    MaxHeight="220"
                    IsVisible="{Binding HasDebugLog}">
                <Grid RowDefinitions="Auto,*">

                    <!-- Header row -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          Background="#3D1F1F"
                          Margin="0">
                        <TextBlock Grid.Column="0"
                                   Text="🐛 Debug-Protokoll"
                                   Foreground="#F38BA8"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="12,6"/>
                        <Button Grid.Column="1"
                                Content="✕ Schließen"
                                Command="{Binding ClearDebugLogCommand}"
                                Height="28"
                                Padding="10,0"
                                FontSize="11"
                                Background="Transparent"
                                Foreground="#F38BA8"
                                BorderThickness="0"
                                Margin="4"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Scrollable log content -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding DebugLog}"
                                   Foreground="#FAB387"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   Margin="12,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
